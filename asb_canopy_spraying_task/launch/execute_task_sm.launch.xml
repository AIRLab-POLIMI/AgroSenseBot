<launch>

  <arg name="enable_spray_actuation" default="true" />
  <arg name="enable_pump" default="false" />
  <arg name="enable_canopy_estimation" default="false" />
  <arg name="auto_set_control_mode_once" default="false" />
  <arg name="auto_set_control_mode" default="false" />
  <arg name="dry_run" default="false" />
  <arg name="loop" default="false" />
  <arg name="enable_viz_topics" default="true" />

  <arg name="use_sim_time" default="false" />

  <node pkg="asb_canopy_spraying_task" exec="canopy_volume_estimation_node" name="canopy_volume_estimation">
    <remap from="points_in" to="/scan_front_multilayer/points_filtered"/>

    <param name="enable_canopy_estimation" value="$(var enable_canopy_estimation)" />
    <param name="canopy_data_dir_path" value="$(env HOME)/asb_logs/canopy_data/arcagna/"/>
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="resolution" value="0.05" />
    <param name="hit_count_threshold" value="5" />
    <param name="max_range" value="5.0" />
    <param name="print_timing" value="false" />
    <param name="enable_viz_topics" value="$(var enable_viz_topics)" />
    <param name="octomap_viz_publish_period" value="5.0" />
  </node>

  <node pkg="asb_canopy_spraying_task" exec="canopy_viz.py" name="canopy_viz" if="$(var enable_viz_topics)">
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="task_plan_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/arcagna/task_plan.yaml"/>
    <param name="nozzle_rate_lookup_table_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/arcagna/nozzle_rate_lookup_table.yaml" />
  </node>

  <node pkg="asb_canopy_spraying_task" exec="spraying_task_sm.py" name="spraying_task_sm">
    <remap from="velocity_odom" to="/ekf_filter_map_odometry"/>

    <!-- task execution params -->
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="task_plan_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/arcagna/task_plan.yaml"/>
    <param name="log_dir_path" value="~/asb_logs/" />
    <param name="auto_set_control_mode_once" value="$(var auto_set_control_mode_once)" />
    <param name="auto_set_control_mode" value="$(var auto_set_control_mode)" />
    <param name="dry_run" value="$(var dry_run)" />
    <param name="loop" value="$(var loop)" />
    <param name="start_up_timeout" value="30.0" />
    <param name="platform_status_timeout" value="0.2" />
    <param name="scan_heartbeat_timeout" value="0.5" />
    <param name="gnss_status_timeout" value="1.5" />
    <param name="start_spray_regulator_timeout" value="10.0" />
    <param name="start_navigation_action_timeout" value="10.0" />
    <param name="min_loop_rate" value="25.0" />
    <param name="target_loop_rate" value="50.0" />

    <!-- navigation params -->
    <param name="base_frame" value="base_link" />
    <param name="robot_pose_time_tolerance" value="0.2" />
    <param name="check_plan_validity_rate" value="2.0" />
    <param name="print_navigation_feedback" value="false" />

    <!-- spraying params -->
    <param name="nozzles_configuration_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/arcagna/nozzles_configuration.yaml" />
    <param name="nozzle_rate_lookup_table_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/arcagna/nozzle_rate_lookup_table.yaml" />
    <param name="enable_spray_actuation" value="$(var enable_spray_actuation)" />
    <param name="enable_pump" value="$(var enable_pump)" />
    <param name="velocity_timeout" value="0.1" />
    <param name="fan_rpm_timeout" value="0.5" />
    <param name="canopy_data_timeout" value="1.0" />
    <param name="canopy_roi_frame_id" value="sprayer_link" />
  </node>

  <!-- ros bag recording of the task session to ~/asb_logs -->
  <include file="$(find-pkg-share asb_logging)/launch/record_bag.launch.py"/>

</launch>
