<launch>

  <arg name="use_sim_time" default="true" />
  <arg name="enable_spray_actuation" default="false" />
  <arg name="enable_pump" default="false" />
  <arg name="enable_viz_topics" default="true" />

  <node pkg="asb_canopy_spraying_task" exec="canopy_volume_estimation_node" name="canopy_volume_estimation">
    <remap from="points_in" to="/scan_front_multilayer/points_filtered"/>

    <param name="enable_canopy_estimation" value="true" />
    <param name="canopy_data_dir_path" value="$(env HOME)/asb_logs/canopy_data/$(env ASB_LOCATION)/"/>
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="resolution" value="0.05" />
    <param name="hit_count_threshold" value="5" />
    <param name="max_range" value="5.0" />
    <param name="print_timing" value="false" />
    <param name="enable_viz_topics" value="$(var enable_viz_topics)" />
    <param name="octomap_viz_publish_period" value="5.0" />
  </node>

  <node pkg="asb_canopy_spraying_task" exec="canopy_viz.py" name="canopy_viz" if="$(var enable_viz_topics)">
    <param name="use_sim_time" value="$(var use_sim_time)" />
    <param name="task_plan_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/$(env ASB_LOCATION)/task_plan.yaml"/>
    <param name="nozzle_rate_lookup_table_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/$(env ASB_LOCATION)/nozzle_rate_lookup_table.yaml" />
  </node>

  <node pkg="asb_canopy_spraying_task" exec="canopy_estimation_from_bag.py" name="canopy_estimation_from_bag">
    <remap from="velocity_odom" to="/ekf_filter_map_odometry"/>

    <param name="use_sim_time" value="$(var use_sim_time)" />

    <!-- task execution params -->
    <param name="task_plan_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/$(env ASB_LOCATION)/task_plan.yaml"/>

    <!-- spraying params -->
    <param name="nozzles_configuration_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/$(env ASB_LOCATION)/nozzles_configuration.yaml" />
    <param name="nozzle_rate_lookup_table_file_path" value="$(find-pkg-share asb_canopy_spraying_task)/config/local_data/$(env ASB_LOCATION)/nozzle_rate_lookup_table.yaml" />
    <param name="enable_spray_actuation" value="$(var enable_spray_actuation)" />
    <param name="enable_pump" value="$(var enable_pump)" />
    <param name="velocity_timeout" value="0.1" />
    <param name="fan_rpm_timeout" value="0.5" />
    <param name="canopy_data_timeout" value="1.0" />
    <param name="canopy_roi_frame_id" value="sprayer_link" />
  </node>

  <include file="$(find-pkg-share asb_ros2_control)/launch/robot_state_publisher.launch.py"/>

</launch>
